   "source": [
    "read the integers a and b\n",
    "start with total as 0\n",
    "use for loop to find sum of all integers from a to b\n",
    "print total"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "0042c569-1b8f-4e3f-9726-4369167b6469",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "7500\n"
     ]
    }
   ],
   "source": [
    "a=100\n",
    "b=200\n",
    "total=0\n",
    "for m in range(a,b+1):\n",
    "    if m%2 !=0:\n",
    "        total=total+m\n",
    "print(total)"
   ]
  },
